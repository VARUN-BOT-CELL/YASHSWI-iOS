
import UIKit
import WebKit

final class YashswiWebViewController: UIViewController,
    WKNavigationDelegate,
    WKDownloadDelegate {

    private let dashboardURL: URL
    private var webView: WKWebView!
    private var isLoggingOut = false
    private let javaScriptBridge = YashswiJavaScriptBridge()

    private var downloads: [
        ObjectIdentifier: (download: WKDownload, url: URL)
    ] = [:]

    // MARK: - Initialization

    init(dashboardURL: URL) {
        self.dashboardURL = dashboardURL
        super.init(nibName: nil, bundle: nil)
    }

    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    override func viewDidLoad() {
        super.viewDidLoad()

        view.backgroundColor = .systemBackground
        setupWebView()
        loadDashboard()
    }

        let compatibilityScript = """
        (function() {
            if (window.top !== window) return;

            const host = window.location.hostname.toLowerCase();

            if (window.location.protocol !== 'https:' ||
                (host !== 'yashswi.in' &&
                 !host.endsWith('.yashswi.in'))) {
                return;
            }

            function send(action, additionalData) {
                window.webkit.messageHandlers.yashswiBridge.postMessage(
                    Object.assign({ action: action }, additionalData || {})
                );
            }

            window.AndroidApp = {
                startLiveTracking: function() {
                    send('startLiveTracking');
                },

                stopLiveTracking: function() {
                    send('stopLiveTracking');
                },

                stopLiveTrackingWithCallback: function(callbackFn) {
                    send('stopLiveTrackingWithCallback', {
                        callback: String(callbackFn)
                    });
                },

                forceSendLocation: function() {
                    send('forceSendLocation');
                },

                logout: function() {
                    send('logout');
                },

                getDeviceId: function() {
                    return '';
                },

                getDeviceID: function() {
                    return '';
                },

                isLocationEnabled: function() {
                    return false;
                },

                showRewardAd: function() {
                    send('showRewardAd');
                }
            };
        })();
        """

        let script = WKUserScript(
            source: compatibilityScript,
            injectionTime: .atDocumentStart,
            forMainFrameOnly: true
        )

        configuration.userContentController.addUserScript(script)

    // MARK: - WebView Setup

    private func setupWebView() {
        let configuration = WKWebViewConfiguration()
        // Register the secure native message receiver.
configuration.userContentController.add(
    javaScriptBridge,
    name: "yashswiBridge"
)

        configuration.websiteDataStore = .default()

        configuration.preferences
            .javaScriptCanOpenWindowsAutomatically = true

        configuration.defaultWebpagePreferences
            .allowsContentJavaScript = true

        webView = WKWebView(
            frame: .zero,
            configuration: configuration
        )

        webView.navigationDelegate = self
        webView.allowsBackForwardNavigationGestures = true

        webView.translatesAutoresizingMaskIntoConstraints = false

        view.addSubview(webView)

        NSLayoutConstraint.activate([
            webView.topAnchor.constraint(
                equalTo: view.safeAreaLayoutGuide.topAnchor
            ),
            webView.leadingAnchor.constraint(
                equalTo: view.leadingAnchor
            ),
            webView.trailingAnchor.constraint(
                equalTo: view.trailingAnchor
            ),
            webView.bottomAnchor.constraint(
                equalTo: view.bottomAnchor
            )
        ])
    }

    private func loadDashboard() {
        webView.load(URLRequest(url: dashboardURL))
    }

    // MARK: - URL Helpers

    private func isYashswiHost(_ host: String) -> Bool {
        let host = host.lowercased()

        return host == "yashswi.in" ||
            host.hasSuffix(".yashswi.in")
    }

    private func isYashswiCookie(
        _ cookie: HTTPCookie
    ) -> Bool {
        let domain = cookie.domain
            .lowercased()
            .trimmingCharacters(
                in: CharacterSet(charactersIn: ".")
            )

        return isYashswiHost(domain)
    }

    private func isDownloadURL(_ url: URL) -> Bool {
        let path = url.path.lowercased()
        let fileName = url.lastPathComponent.lowercased()

        let extensions = [
            ".pdf",
            ".xlsx",
            ".xls",
            ".csv"
        ]

        if extensions.contains(where: {
            fileName.hasSuffix($0)
        }) {
            return true
        }

        return path.contains("download") ||
            path.contains("print_report") ||
            path.contains("export")
    }

    // MARK: - Navigation Handling

    func webView(
        _ webView: WKWebView,
        decidePolicyFor navigationAction: WKNavigationAction,
        decisionHandler: @escaping (WKNavigationActionPolicy) -> Void
    ) {
        guard !isLoggingOut else {
            decisionHandler(.cancel)
            return
        }

        guard let url = navigationAction.request.url else {
            decisionHandler(.cancel)
            return
        }

        let scheme = url.scheme?.lowercased() ?? ""
        let host = url.host?.lowercased() ?? ""
        let path = url.path.lowercased()

        // Phone, WhatsApp and email links.
        if ["tel", "whatsapp", "mailto"].contains(scheme) {
            decisionHandler(.cancel)

            UIApplication.shared.open(url)
            return
        }

        // Permit internal empty-page navigation.
        if scheme == "about" &&
            url.absoluteString == "about:blank" {
            decisionHandler(.allow)
            return
        }

        guard scheme == "https" || scheme == "http" else {
            decisionHandler(.cancel)
            return
        }

        let isYashswi = isYashswiHost(host)

        // Login-expiry and logout handling.
        if isYashswi &&
            (path.hasSuffix("/auth/login.php") ||
             path.hasSuffix("/logout.php")) {

            decisionHandler(.cancel)
            completeLocalLogout()
            return
        }

        // External websites open outside the app.
        if !isYashswi {
            decisionHandler(.cancel)

            UIApplication.shared.open(url)
            return
        }

        // Known GET report links should download.
        // Keep POST requests intact for form submissions.
        let method = navigationAction.request
            .httpMethod?.uppercased() ?? "GET"

        if method == "GET" && isDownloadURL(url) {
            decisionHandler(.download)
            return
        }

        // All other internal pages stay inside WKWebView.
        decisionHandler(.allow)
    }

    // MARK: - Response Download Detection

    func webView(
        _ webView: WKWebView,
        decidePolicyFor navigationResponse: WKNavigationResponse,
        decisionHandler: @escaping (WKNavigationResponsePolicy) -> Void
    ) {
        guard !isLoggingOut else {
            decisionHandler(.cancel)
            return
        }

        let response = navigationResponse.response

        guard let url = response.url,
              let host = url.host,
              isYashswiHost(host) else {
            decisionHandler(.allow)
            return
        }

        let mimeType = response.mimeType?
            .lowercased() ?? ""

        let downloadableTypes = [
            "application/pdf",
            "application/octet-stream",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "text/csv"
        ]

        var isAttachment = false

        if let httpResponse = response as? HTTPURLResponse {
            let disposition = httpResponse.value(
                forHTTPHeaderField: "Content-Disposition"
            )?.lowercased() ?? ""

            isAttachment = disposition.contains("attachment")
        }

        if navigationResponse.isForMainFrame &&
            (isAttachment ||
             downloadableTypes.contains(mimeType) ||
             !navigationResponse.canShowMIMEType) {

            decisionHandler(.download)
            return
        }

        decisionHandler(.allow)
    }

    // MARK: - Convert Navigation Into Download

    func webView(
        _ webView: WKWebView,
        navigationAction: WKNavigationAction,
        didBecome download: WKDownload
    ) {
        download.delegate = self
    }

    func webView(
        _ webView: WKWebView,
        navigationResponse: WKNavigationResponse,
        didBecome download: WKDownload
    ) {
        download.delegate = self
    }

    // MARK: - Download Destination

    func download(
        _ download: WKDownload,
        decideDestinationUsing response: URLResponse,
        suggestedFilename: String,
        completionHandler: @escaping (URL?) -> Void
    ) {
        let rawName = (suggestedFilename as NSString)
            .lastPathComponent

        let fileName: String

        if rawName.isEmpty ||
            rawName == "." ||
            rawName == ".." {
            fileName = "YashswiReport"
        } else {
            fileName = rawName
        }

        let folder = FileManager.default
            .temporaryDirectory
            .appendingPathComponent(
                "YashswiDownloads",
                isDirectory: true
            )
            .appendingPathComponent(
                UUID().uuidString,
                isDirectory: true
            )

        do {
            try FileManager.default.createDirectory(
                at: folder,
                withIntermediateDirectories: true
            )

            let destination = folder
                .appendingPathComponent(fileName)

            downloads[ObjectIdentifier(download)] = (
                download: download,
                url: destination
            )

            completionHandler(destination)

        } catch {
            completionHandler(nil)
            showError(
                "Unable to prepare the report download."
            )
        }
    }

    // MARK: - Download Completed

    func downloadDidFinish(_ download: WKDownload) {
        let identifier = ObjectIdentifier(download)

        guard let item = downloads.removeValue(
            forKey: identifier
        ) else {
            return
        }

        let fileURL = item.url

        guard FileManager.default.fileExists(
            atPath: fileURL.path
        ) else {
            showError("Downloaded report was not found.")
            return
        }

        let shareController = UIActivityViewController(
            activityItems: [fileURL],
            applicationActivities: nil
        )

        if let popover = shareController
            .popoverPresentationController {

            popover.sourceView = view
            popover.sourceRect = CGRect(
                x: view.bounds.midX,
                y: view.bounds.midY,
                width: 1,
                height: 1
            )
        }

        present(shareController, animated: true)
    }

    // MARK: - Download Failed

    func download(
        _ download: WKDownload,
        didFailWithError error: Error,
        resumeData: Data?
    ) {
        downloads.removeValue(
            forKey: ObjectIdentifier(download)
        )

        if (error as NSError).code == NSURLErrorCancelled {
            return
        }

        showError(
            "Report download failed: \(error.localizedDescription)"
        )
    }

    // MARK: - Logout

    private func completeLocalLogout() {
        guard !isLoggingOut else { return }

        isLoggingOut = true

        webView.stopLoading()
        webView.loadHTMLString("", baseURL: nil)

        AppSession.shared.signOut()

        let cookieStore = WKWebsiteDataStore
            .default()
            .httpCookieStore

        cookieStore.getAllCookies { [weak self] cookies in
            guard let self = self else { return }

            let relevantCookies = cookies.filter {
                self.isYashswiCookie($0)
            }

            let group = DispatchGroup()

            for cookie in relevantCookies {
                group.enter()

                cookieStore.delete(cookie) {
                    group.leave()
                }
            }

            group.notify(queue: .main) {
                let storage = HTTPCookieStorage.shared

                for cookie in storage.cookies ?? [] {
                    if self.isYashswiCookie(cookie) {
                        storage.deleteCookie(cookie)
                    }
                }

                self.downloads.removeAll()

                if let window = self.view.window {
                    window.rootViewController =
                        LoginViewController()

                    window.makeKeyAndVisible()
                }
            }
        }
    }

    // MARK: - Navigation Errors

    func webView(
        _ webView: WKWebView,
        didFailProvisionalNavigation navigation: WKNavigation!,
        withError error: Error
    ) {
        guard !isLoggingOut else { return }

        if (error as NSError).code ==
            NSURLErrorCancelled {
            return
        }

        showError(error.localizedDescription)
    }

    // MARK: - Alerts

    private func showError(_ message: String) {
        guard !isLoggingOut else { return }

        let alert = UIAlertController(
            title: "YASHSWI",
            message: message,
            preferredStyle: .alert
        )

        alert.addAction(
            UIAlertAction(title: "OK", style: .default)
        )

        present(alert, animated: true)
    }
}
